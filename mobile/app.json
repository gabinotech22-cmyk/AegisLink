{
  "expo": {
    "name": "AegisLink",
    "slug": "aegislink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aegislink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aegislink.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "AegisLink uses the camera to scan verification QR codes and send encrypted photos.",
        "NSMicrophoneUsageDescription": "AegisLink uses the microphone for encrypted voice and video calls.",
        "NSPhotoLibraryUsageDescription": "AegisLink accesses your photo library to send encrypted attachments.",
        "NSFaceIDUsageDescription": "AegisLink uses Face ID to protect your messages. Your biometric data never leaves the device.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "voip",
          "audio",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSPinnedDomains": {
            "aegislink.duckdns.org": {
              "NSIncludesSubdomains": true,
              "NSPinnedCAIdentities": [
                {
                  "SPKI-SHA256-BASE64": "CMcP8NMKUoqDBl0haU7v7dgEsxIFbWry8NjhhHzgX3c="
                },
                {
                  "SPKI-SHA256-BASE64": "iFvwVyJSxnQdyaUvUERIf+8qk7gRze3612JMwoO3zdU="
                },
                {
                  "SPKI-SHA256-BASE64": "LvglXAxgB9K5SCOZrLvdX0VVc8UuEU+Bj6r58LSA7r8="
                }
              ]
            }
          }
        }
      },
      "bitcode": false,
      "buildNumber": "1"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#5bf2b9"
    },
    "android": {
      "package": "com.aegislink.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "aegislink.duckdns.org", "path": "/g" },
            { "scheme": "https", "host": "aegislink.duckdns.org", "path": "/a" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#5bf2b9",
        "androidMode": "default",
        "androidCollapsedTitle": "AegisLink · #{unread_notifications} mensajes"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e0d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "plugins": [
      "./app.plugin.js",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AegisLink accesses your photo library to send encrypted view-once media.",
          "cameraPermission": "AegisLink uses the camera to capture encrypted view-once media."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AegisLink uses the camera to scan QR codes and send encrypted photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "AegisLink uses the microphone for encrypted voice and video calls."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow AegisLink to access the camera for end-to-end encrypted video calls.",
          "microphonePermission": "Allow AegisLink to access the microphone for end-to-end encrypted calls."
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5bf2b9",
          "iosDisplayInForeground": true,
          "sounds": [
            "./assets/sounds/msg_received.mp3",
            "./assets/sounds/call_incoming.mp3"
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        {
          "icons": [
            {
              "name": "light",
              "ios": "./assets/icon-light.png",
              "android": "./assets/icon-light.png"
            },
            {
              "name": "tinted",
              "ios": "./assets/icon-tinted.png",
              "android": "./assets/icon-tinted.png"
            },
            {
              "name": "work",
              "ios": "./assets/icon-work.png",
              "android": "./assets/icon-work.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f658c210-cfa9-482e-85ae-610cc76152af"
      }
    },
    "owner": "crowfn",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f658c210-cfa9-482e-85ae-610cc76152af",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
