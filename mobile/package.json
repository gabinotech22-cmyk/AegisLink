{
  "name": "aegislink-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-dev-client",
        "expo-dev-launcher",
        "expo-dev-menu"
      ]
    }
  },
  "scripts": {
    "start": "cross-env AEGIS_EXPO_GO=1 expo start",
    "start:dev": "expo start",
    "android": "cross-env AEGIS_EXPO_GO=1 expo start --android",
    "ios": "cross-env AEGIS_EXPO_GO=1 expo start --ios",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "fuzz": "jest src/fuzz --maxWorkers=1",
    "fuzz:bundle": "esbuild src/fuzz/targets.ts --bundle --platform=node --format=cjs --outfile=fuzz/targets.bundle.js",
    "gen-icons": "node scripts/gen-icons.mjs",
    "build:apk": "eas build --platform android --profile production-apk --local",
    "build:native": "npx expo prebuild --platform android && cd android && .\\gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@noble/hashes": "^1.6.1",
    "@noble/post-quantum": "^0.7.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@scure/base": "^2.3.0",
    "@testing-library/react-native": "^13.3.3",
    "expo": "~54.0.37",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-av": "~16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "i18next": "^26.4.0",
    "jail-monkey": "^3.0.0",
    "react": "19.1.4",
    "react-i18next": "^17.0.12",
    "react-native": "0.81.6",
    "react-native-callkeep": "^4.3.16",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-incall-manager": "^4.2.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-video-trim": "^8.2.2",
    "react-native-view-shot": "^5.1.1",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "^0.8.3",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.12",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1",
    "js-yaml": "^4.2.0",
    "react-test-renderer": "19.1.4"
  }
}
