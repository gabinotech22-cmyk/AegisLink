# ─────────────────────────────────────────────────────────────
# AegisLink — Mobile environment variables
# Copy to .env (dev) or configure as EAS secrets (production).
# All EXPO_PUBLIC_* vars are bundled into the JS — never put
# private keys or secrets here.
# ─────────────────────────────────────────────────────────────

# ── Development ──────────────────────────────────────────────
# LAN IP of your dev machine (find with `ipconfig` on Windows,
# `ifconfig` on macOS/Linux — look for the Wi-Fi IPv4 address).
# Phone and machine must be on the same Wi-Fi network.
# Android Emulator default (10.0.2.2) works without this.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.4:3001

# ── Production (Oracle Cloud VM) ─────────────────────────────
# Public IP of the Oracle Cloud VM running the relay + coturn.
# When set, SERVER_URL and TURN_SERVER_URL are derived from it
# automatically in non-__DEV__ builds.
# Add as an EAS secret: eas secret:create --name EXPO_PUBLIC_ORACLE_IP
EXPO_PUBLIC_ORACLE_IP=

# Relay port (default 3001 — matches docker-compose on the VM).
# Override only if you changed the port mapping.
# EXPO_PUBLIC_RELAY_PORT=3001

# ── Manual overrides (optional) ──────────────────────────────
# Set these only if you need to override the derived URLs.
# EXPO_PUBLIC_RELAY_URL=http://<IP>:3001
# EXPO_PUBLIC_TURN_URL=turn:<IP>:3478
# EXPO_PUBLIC_TURN_USERNAME=aegislink
# EXPO_PUBLIC_TURN_PASSWORD=your_coturn_static_secret
