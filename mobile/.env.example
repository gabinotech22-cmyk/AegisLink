# ================================================
# AegisLink Mobile — Variables de entorno
# Copia a mobile/.env y ajusta los valores
# NUNCA comitear .env con valores reales
# ================================================

# ---- Relay URL ----
# Android emulator: el host del emulador es 10.0.2.2
# iOS simulator:    el host es localhost directamente
# Dispositivo físico en LAN: usa la IP local de tu máquina (ej. 192.168.1.x)
EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3001

# Alias utilizado por módulos de registro y cripto; si no se define,
# hereda el valor de EXPO_PUBLIC_SERVER_URL automáticamente.
# EXPO_PUBLIC_RELAY_URL=http://10.0.2.2:3001

# ---- Producción (descomenta y ajusta) ----
# EXPO_PUBLIC_SERVER_URL=https://aegislink.duckdns.org

# ---- AWS EC2 (alternativa a duckdns para producción) ----
# EXPO_PUBLIC_RELAY_IP=<ip-publica-aws>
# EXPO_PUBLIC_RELAY_PORT=3001

# ---- TURN/STUN (coturn self-hosted) ----
EXPO_PUBLIC_TURN_URL=turn:localhost:3478
# Producción:
# EXPO_PUBLIC_TURN_URL=turn:<ip-o-dominio>:3478

# ---- Opcional: Tor hidden service ----
# EXPO_PUBLIC_ONION_URL=http://youronionaddress.onion
