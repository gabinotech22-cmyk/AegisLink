# EAS upload ignore.
#
# Exclude the local native dirs so EAS does a MANAGED prebuild from app.json +
# app.plugin.js on the build server. This (a) keeps the upload small — the local
# android/ holds multi-GB Gradle build artifacts that blew past the 2 GB limit —
# and (b) GUARANTEES the current app.json / app.plugin.js hardening (R8/ProGuard,
# cert pins, permission trims, screen-capture, network-security-config) is what
# actually gets built, instead of a stale prebuilt android/.
android/
ios/

# Dependencies — EAS reinstalls from package-lock on the build server. In
# EAS_NO_VCS mode this is NOT auto-excluded, and it is the multi-GB bulk.
node_modules/

# Build output / large local artifacts
*.apk
*.aab
*.keystore
*.jks
.expo/
dist/
build/
web-build/

# OTA signing PRIVATE key (the build only needs the public cert in certs/)
keys/

# Misc local noise
*.log
coverage/
