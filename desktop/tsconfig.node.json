{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "better-sqlite3"],
    "outDir": "out"
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/main/**/*.json",
    "src/preload/**/*.ts"
  ]
}
