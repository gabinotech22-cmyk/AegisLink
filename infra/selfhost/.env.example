# AegisLink self-hosted relay — copy to .env (docs/SELF-HOSTING.md)
#
# ./up.sh fills BLOB_SECRET and TURN_SECRET with random values if they are
# empty. Everything else is optional.

# Shown by the app's "Verify relay" (GET /relay/info).
RELAY_NAME=My AegisLink relay

# Secrets (32+ random bytes, hex/base64). Generated by ./up.sh when empty.
BLOB_SECRET=
TURN_SECRET=

# Optional coturn on a PUBLIC IP for calls through NAT (see compose comments).
# TURN_HOST=turn.example.org
# TURN_PORT=3478

# Charge a small proof-of-work per submitted envelope (anti-spam). off | on
MAILBOX_SUBMIT_POW=off

# Directory lookups of your users' ids (GET /identity/:id). on | off
IDENTITY_LOOKUP=on

# Mailbox wake-up push via the co-hosted ntfy (over the onion). on | off
PUSH_MAILBOX_ENABLED=on

# Onion service flavour (infra/tor/). torrc.selfhost = location-hidden, full
# 3-hop service side (default: nobody learns this machine's IP). torrc = the
# official relay's single-onion mode: ~half the latency, but the Tor network
# sees your IP — only for a machine whose location is public anyway.
# Switching modes needs a NEW onion address (docker volume rm selfhost_tor_keys).
ONION_TORRC=torrc.selfhost
