# AegisLink SELF-HOSTED relay — Tor onion service (federation F6/F7,
# docs/SELF-HOSTING.md). Built by infra/selfhost/docker-compose.yml with
# `TORRC=torrc.selfhost`.
#
# Same job as ./torrc (the official relay's): publish the relay as a v3 onion
# service so clients (embedded Tor) reach it without it ever seeing their IP.
# NOT a Tor relay or exit; no client SOCKS traffic.
#
# Zero-metadata guarantees at this layer:
#   - Onion-client IPs are invisible to us by protocol design (rendezvous).
#   - Log level stays at notice: tor logs no per-connection data there.
#   - The onion identity key lives ONLY in the tor_keys docker volume
#     (/var/lib/tor). Treat it like a private key: losing it rotates the
#     .onion address and every client build must update EXPO_PUBLIC_ONION_URL.

# No client SOCKS.
SocksPort 0

DataDirectory /var/lib/tor
Log notice stdout

# ── Location-hidden (the default for a relay that is someone's home) ────────
# Unlike the official relay (./torrc, single-onion mode), a self-hosted relay
# has NO public clearnet identity — hiding where it runs is part of what the
# operator gets. So this torrc keeps the full 3-hop service side: nobody, not
# even the Tor network, learns the machine's IP from the .onion. The cost is
# ~2× onion latency versus single-onion mode.
#
# If your machine's location is public anyway (a VPS with a known IP that you
# do not mind linking to the relay) and you want the latency back, set
# ONION_TORRC=torrc in infra/selfhost/.env and run ./up.sh again: the image is
# then built from ./torrc (single-onion, non-anonymous SERVICE side; clients
# keep their 3 hops). Tor refuses to reuse a key directory across the two
# modes, so switching means a NEW .onion address (see docs/SELF-HOSTING.md).

# ── The relay onion service ──────────────────────────────────────────────────
# v3 onion (ed25519). Virtual port 80 → relay:3001 over the aegis_internal
# docker network. Clients use http://<addr>.onion — the Tor rendezvous already
# provides E2E encryption and endpoint authentication, so TLS on top is
# redundant (mobile/src/config.ts exempts .onion from the https guard for
# exactly this reason).
#
# NOTE: tor resolves the "relay" hostname when it (re)starts. infra/deploy.sh
# therefore restarts this container AFTER the relay container is up, so a
# recreated relay (new IP on aegis_internal) never leaves tor dialing a stale
# address.
HiddenServiceDir /var/lib/tor/aegislink_relay
HiddenServiceVersion 3
HiddenServicePort 80 relay:3001
# Fase 4 · Slice 2b: same onion, additional virtual port for mailbox clients
# to subscribe to their ntfy wake-up topic over Tor (co-hosted ntfy, never
# exposed on clearnet). Publish stays relay-internal (push/ntfy.ts -> ntfy:80).
HiddenServicePort 8090 ntfy:80
