# AegisLink — Environment variable template
# Copy to .env and fill in real values. NEVER commit .env to git.
#
# All values here are either public defaults or placeholders.
# Secrets (TURN_SECRET, FCM_SERVER_KEY, etc.) must be set via:
#   - CI/CD secrets (GitHub Actions → Settings → Secrets)
#   - Server environment (e.g. /etc/aegislink.env sourced by systemd)

# ── Relay ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
DB_PATH=/data/aegis.db
TRUST_PROXY=1

# Allowed CORS origins for the relay (comma-separated or * for dev)
CORS_ORIGIN=https://aegislink.duckdns.org

# ── TURN / coturn ──────────────────────────────────────────────────────────
# 256-bit random hex string. Rotate every 24 h via infra/scripts/rotate-turn-creds.ts
TURN_SECRET=REPLACE_WITH_RANDOM_HEX_64_CHARS

# Hostname / IP that the relay uses when constructing TURN credential responses
TURN_HOST=turn.aegislink.io
TURN_PORT=3478
TURNS_PORT=5349

# Public IP of the coturn host (injected into turnserver.conf by deploy.sh)
EXTERNAL_IP=REPLACE_WITH_SERVER_PUBLIC_IP

# ── Push notifications (wake-up only — no payload content) ────────────────
FCM_SERVER_KEY=REPLACE_WITH_FCM_KEY
APNS_KEY_ID=REPLACE_WITH_APNS_KEY_ID
APNS_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID

# ── EAS / Expo (CI only) ────────────────────────────────────────────────────
# EXPO_TOKEN=REPLACE_WITH_EAS_PERSONAL_ACCESS_TOKEN

# ── SSH Deploy (CI only) ────────────────────────────────────────────────────
# DEPLOY_HOST=your.server.ip
# DEPLOY_USER=deploy
# DEPLOY_PATH=/opt/aegislink
