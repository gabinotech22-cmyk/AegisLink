# ================================================
# AegisLink — Configuración compartida
# Copia este archivo a .env y ajusta los valores
# NUNCA comitear .env con valores reales
# ================================================

# ---- Relay URL — PRODUCCIÓN (AWS · aegislink.duckdns.org) ----
EXPO_PUBLIC_SERVER_URL=https://aegislink.duckdns.org
EXPO_PUBLIC_RELAY_URL=https://aegislink.duckdns.org
VITE_RELAY_URL=https://aegislink.duckdns.org

# ---- TURN/STUN — PRODUCCIÓN (coturn en AWS, mismo host) ----
EXPO_PUBLIC_TURN_URL=turn:aegislink.duckdns.org:3478
VITE_TURN_URL=turn:aegislink.duckdns.org:3478
TURN_SECRET=change-me-use-openssl-rand-hex-32

# ---- Server (en AWS) ----
PORT=3001
# Secreto para los tokens de descarga de blobs (C-1). OBLIGATORIO en producción:
# sin él el server falla cerrado al arrancar. Genera con: openssl rand -hex 32
BLOB_SECRET=change-me-use-openssl-rand-hex-32
# CORS bloqueado al dominio propio en producción
CORS_ORIGIN=https://aegislink.duckdns.org
# Feature flag de canales públicos (routes/publicChannels.ts). Default off:
# el relay responde 404 FEATURE_DISABLED hasta ponerlo en 'on'. Debe estar
# también listado en el bloque environment: de docker-compose.yml.
PUBLIC_CHANNELS=off

# ---- Dev local (descomenta solo para desarrollo en local) ----
# Android emulator → usa 10.0.2.2:3001
# EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3001
# iOS simulator / Desktop → usa localhost:3001
# VITE_RELAY_URL=http://localhost:3001
# EXPO_PUBLIC_TURN_URL=turn:localhost:3478
# CORS_ORIGIN=*
DATABASE_URL=./data/aegislink.db
# Para PostgreSQL:
# DATABASE_URL=postgres://user:pass@localhost:5432/aegislink

# ---- Proxy inverso ----
# 1 = hay un proxy delante (nginx/caddy). 0 = sin proxy.
TRUST_PROXY=1

# ---- Opcional: Tor hidden service ----
# EXPO_PUBLIC_ONION_URL=http://youronionaddress.onion
