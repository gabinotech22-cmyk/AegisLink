# ─────────────────────────────────────────────────────────────────────────────
# AegisLink Relay — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Port the relay listens on.
# Default: 3001
PORT=3001

# CORS allowed origins. Comma-separated list of Origins, or '*' for open access.
# Lock down to specific domains in production.
# Default: *
CORS_ORIGIN=*

# Number of trusted reverse-proxy hops in front of this server.
# Set to 1 when running behind nginx/Caddy. Set to 0 if no proxy.
# Default: 1
TRUST_PROXY=1

# Absolute (or relative) path to the SQLite database file.
# The directory will be created automatically if it does not exist.
# Default: ./data/aegislink.db
AEGIS_DB_PATH=./data/aegislink.db

# HMAC-SHA1 shared secret used to sign ephemeral TURN credentials (RFC 8489).
# Generate with: openssl rand -hex 32
# Rotate every 24 hours via cron. REQUIRED for /turn/credentials to work.
# If unset, the endpoint returns 503.
TURN_SECRET=

# NODE_ENV controls Express error verbosity.
# Values: development | production
# Default (unset): development behaviour
NODE_ENV=production

# KLIPY_KEY — GIF provider key for /proxy/gif (KLIPY, the Tenor successor;
# Google shut down the Tenor public API on 2026-06-30). Get a free key at
# https://klipy.com/developers. If unset, /proxy/gif returns 503 and the
# in-app GIF picker shows "GIFs not available".
KLIPY_KEY=

# ─── iOS VoIP push (PushKit / APNs) ──────────────────────────────────────────
# Wakes a fully-killed iOS app to ring an incoming call. APNS_KEY_ID,
# APNS_TEAM_ID and APNS_KEY_P8 are REQUIRED together (APNS_BUNDLE_ID has a
# default and does not gate config); if a required var is missing OR the .p8 is
# malformed, the relay silently skips VoIP pushes and iOS falls back to the Expo
# visible wake-up (isApnsConfigured() → false).
#
# APNS_KEY_ID   — the 10-char Key ID of your APNs Auth Key (.p8), from
#                 developer.apple.com → Certificates, IDs & Profiles → Keys.
# APNS_TEAM_ID  — your 10-char Apple Developer Team ID.
# APNS_BUNDLE_ID— the app bundle id; the VoIP topic is <bundle>.voip.
#                 Default: com.aegislink.app
# APNS_KEY_P8   — the FULL contents of the .p8 file. Keep the BEGIN/END lines;
#                 replace real newlines with \n so it fits on one env line.
# APNS_HOST     — "sandbox" for the APNs development server; anything else (or
#                 unset) uses production (api.push.apple.com).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.aegislink.app
APNS_KEY_P8=
APNS_HOST=
